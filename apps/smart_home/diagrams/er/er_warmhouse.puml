@startuml ER_WARMHOUSE
together{
    entity Customer {
        * customer_id : integer <<PK>>
        --
        name : string
        email : string
        deleted: boolean
        createdAt: date
        updatedAt: date
    }

    entity House {
        * house_id : integer <<PK>>
        --
        customer_id : integer <<FK>>
        label : string
        deleted: boolean
        createdAt: date
        updatedAt: date
    }

    entity Room {
        * room_id : integer <<PK>>
        --
        device_id: integer
        customer_id : integer integer <<FK>>
        house_id: integer integer <<FK>>
        label : string
        email : string
        deleted: boolean
        createdAt: date
        updatedAt: date
    }

    entity Device {
        * device_id : integer <<PK>>
        --
        token: string
        customer_id : integer
        label : string
        state: json
        type: enum
        deleted: boolean
        createdAt: date
        updatedAt: date
    }
}

entity Scripts {
        * script_id : integer <<PK>>
        --
        label: string
        type: enum
        createdAt: date
        updatedAt: date
}

entity ScriptEvents {
        * script_id : integer <<PK>>
        --
        device_id: integer
        state: json
        step: integer
        nextStep: integer
        trigger: json
        createdAt: date
        updatedAt: date
}

entity ScriptRunFlow {
        * script_id : integer <<PK>>
        --
        label: string
        createdAt: date
        updatedAt: date
}

together {
    entity DeviceEvents {
        * event_id : integer <<PK>>
        --
        device_id: integer
        event : string
        params: json
        direction: enum
        status: enum
        createdAt: date
        updatedAt: date
    }    
}

    Customer "1" --> "N" Scripts
    Customer "1" --> "N" House
    Customer "1" --> "N" Device
    House "1" --> "N" Room
    Device "1" <--> "N" DeviceEvents
@enduml